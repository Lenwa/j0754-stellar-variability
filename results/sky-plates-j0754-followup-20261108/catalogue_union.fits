TFORM12 = 'E       '                                                            TTYPE13 = 'gaiaedr3_id'                                                         TFORM13 = 'K       '                                                            TNULL13 =               999999                                                  TTYPE14 = 'gaiaedr3_dist'                                                       TFORM14 = 'E       '                                                            TUNIT14 = 'arcsec  '                                                            TTYPE15 = 'phot_range_flags'                                                    TFORM15 = 'I       '                                                            TNULL15 =                16959                                                  TTYPE16 = 'annular_bin'                                                         TFORM16 = 'I       '                                                            TNULL16 =                16959                                                  COMMENT --BEGIN-ASTROPY-SERIALIZED-COLUMNS--                                    COMMENT datatype:                                                               COMMENT - name: source_id                                                       COMMENT   datatype: int64                                                       COMMENT   description: 'Source identification number. The number is constructe\ COMMENT d as follows: 4 x 10^13 + process_id x 10^7 + source number in          COMMENT     the image.'                                                         COMMENT   meta: !!omap                                                          COMMENT   - {ucd: meta.id;meta.main}                                            COMMENT - name: process_id                                                      COMMENT   datatype: int32                                                       COMMENT   description: Process identification number                            COMMENT   meta: !!omap                                                          COMMENT   - {ucd: meta.id}                                                      COMMENT - name: scan_id                                                         COMMENT   datatype: int32                                                       COMMENT   description: Scan identification number                               COMMENT   meta: !!omap                                                          COMMENT   - {ucd: meta.id}                                                      COMMENT - name: plate_id                                                        COMMENT   datatype: int32                                                       COMMENT   description: Plate identification number                              COMMENT   meta: !!omap                                                          COMMENT   - {ucd: meta.id}                                                      COMMENT - name: ra_icrs                                                         COMMENT   datatype: float64                                                     COMMENT   description: Right ascension of the source (International Celestial \ COMMENT Reference System)                                                       COMMENT   meta: !!omap                                                          COMMENT   - {ucd: pos.eq.ra}                                                    COMMENT - name: dec_icrs                                                        COMMENT   datatype: float64                                                     COMMENT   description: Declination of the source (International Celestial Refe\ COMMENT rence System)                                                           COMMENT   meta: !!omap                                                          COMMENT   - {ucd: pos.eq.dec}                                                   COMMENT - name: sextractor_flags                                                COMMENT   datatype: int16                                                       COMMENT   description: Flags given by SExtractor                                COMMENT   meta: !!omap                                                          COMMENT   - {ucd: meta.code}                                                    COMMENT - name: nn_dist                                                         COMMENT   unit: arcsec                                                          COMMENT   datatype: float32                                                     COMMENT   description: Distance to the nearest neighbor among extracted source\ COMMENT s                                                                       COMMENT   meta: !!omap                                                          COMMENT   - {ucd: pos.angDistance}                                              COMMENT - name: model_prediction                                                COMMENT   datatype: float32                                                     COMMENT   description: Classification of the source as celestial (value close \ COMMENT to 1) or artifact (value close to 0). The value is a prediction         COMMENT     by a machine-learning algorithm.                                    COMMENT   meta: !!omap                                                          COMMENT   - {ucd: stat.likelihood}                                              COMMENT - name: cat_natmag                                                      COMMENT   unit: mag                                                             COMMENT   datatype: float32                                                     COMMENT   description: Magnitude of the source in the plate natural photometri\ COMMENT c system, RP+color_term * (BP-RP), based on the Gaia EDR3 catalogue     COMMENT   meta: !!omap                                                          COMMENT   - {ucd: phot.mag;em.opt}                                              COMMENT - name: natmag                                                          COMMENT   unit: mag                                                             COMMENT   datatype: float32                                                     COMMENT   description: Calibrated magnitude of the source in the plate natural\ COMMENT  photometric system                                                     COMMENT   meta: !!omap                                                          COMMENT   - {ucd: phot.mag;em.opt}                                              COMMENT - {name: gaiaedr3_bp_rp, datatype: float32, description: Gaia EDR3 BP-\ COMMENT RP color index of the matched source}                                   COMMENT - {name: gaiaedr3_id, datatype: int64, description: Gaia EDR3 source_i\ COMMENT d of the matched source}                                                COMMENT - {name: gaiaedr3_dist, unit: arcsec, datatype: float32, description: \ COMMENT Angular distance in the sky plane between the source and the matched    COMMENT     Gaia EDR3 source}                                                   COMMENT - {name: phot_range_flags, datatype: int16, description: 'Photometric \ COMMENT range flags: 0 - source natmag is in the range of calibration           COMMENT     stars; 1 - source natmag is brighter than the brightest calibratio\ COMMENT n star; 2 - source natmag is fainter than the estimated faint           COMMENT     limit of the plate'}                                                COMMENT - name: annular_bin                                                     COMMENT   datatype: int16                                                       COMMENT   description: Annular bin (1-9) where the source belongs (bin 1 is in\ COMMENT  the center, bin 9 is at the edge)                                      COMMENT   meta: !!omap                                                          COMMENT   - {ucd: meta.code}                                                    