# %ECSV 1.0
# ---
# datatype:
# - name: iauname
#   datatype: string
#   description: Official IAU name of source
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: skytile
#   datatype: string
#   description: Sky tile ID
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - {name: id_src, datatype: int16, description: Source ID in each sky tile}
# - {name: id_cluster, datatype: int16, description: Group ID of simultaneously fitted sources}
# - name: detuid
#   datatype: string
#   description: Unique detection ID
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - {name: uid, datatype: int64, description: Integer unique detection ID}
# - {name: uid_5xmm, datatype: int64, description: Unknown}
# - name: uid_csc
#   datatype: string
#   description: Unknown
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - {name: flag_csc, datatype: int64, description: Unknown}
# - {name: uid_2rxs, datatype: int64, description: Unknown}
# - {name: uid_dr1, datatype: int64, description: Unknown}
# - {name: uid_hard, datatype: int64, description: Hard catalog UID}
# - name: ra
#   unit: deg
#   datatype: float64
#   description: Right ascension (ICRS), corrected
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
# - name: dec
#   unit: deg
#   datatype: float64
#   description: Declination (ICRS), corrected
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
# - {name: pos_err, unit: arcsec, datatype: float64, description: 'Combined position error, from PSF fitting'}
# - {name: ra_lowerr, unit: arcsec, datatype: float32, description: 1-sigma RA lower bound}
# - {name: ra_uperr, unit: arcsec, datatype: float32, description: 1-sigma RA upper bound}
# - {name: dec_lowerr, unit: arcsec, datatype: float32, description: 1-sigma DEC lower bound}
# - {name: dec_uperr, unit: arcsec, datatype: float32, description: 1-sigma DEC upper bound}
# - {name: radec_err, unit: arcsec, datatype: float32, description: 1-sigma position uncertainty}
# - {name: ra_raw, unit: deg, datatype: float64, description: 'Right ascension (ICRS), uncorrected'}
# - {name: dec_raw, unit: deg, datatype: float64, description: 'Declination (ICRS), uncorrected'}
# - {name: lii, unit: deg, datatype: float64, description: Galactic longitude}
# - {name: bii, unit: deg, datatype: float64, description: Galactic latitude}
# - {name: elon, unit: deg, datatype: float64, description: Ecliptic longitude}
# - {name: elat, unit: deg, datatype: float64, description: Ecliptic latitude}
# - {name: ext, unit: arcsec, datatype: float32, description: Source extent parameter}
# - {name: ext_err, unit: arcsec, datatype: float32, description: 1-sigma error on EXT}
# - {name: ext_lowerr, unit: arcsec, datatype: float32, description: 1-sigma EXT lower bound}
# - {name: ext_uperr, unit: arcsec, datatype: float32, description: 1-sigma EXT upper bound}
# - {name: ext_like, datatype: float32, description: Extent likelihood}
# - {name: det_like_0, datatype: float32, description: Detection likelihood (band 0)}
# - {name: ml_cts_1, unit: count, datatype: float32, description: Source net counts (band 1)}
# - {name: ml_cts_err_1, unit: count, datatype: float32, description: 1-sigma error on ML_CTS_1}
# - {name: ml_cts_lowerr_1, unit: count, datatype: float32, description: 1-sigma ML_CTS_1 lower bound}
# - {name: ml_cts_uperr_1, unit: count, datatype: float32, description: 1-sigma ML_CTS_1 upper bound}
# - {name: ml_rate_1, unit: count.s**-1, datatype: float32, description: Source count rate (band 1)}
