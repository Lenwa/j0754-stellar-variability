    </DESCRIPTION>

    <TABLE ID="DR2_Main">
      <DESCRIPTION>eROSITA DR2 eRASS:3 Main Catalogue</DESCRIPTION>
      <FIELD name="iauname" datatype="char" arraysize="*" ucd="ID_MAIN"><DESCRIPTION>Official IAU name of source</DESCRIPTION></FIELD>
<FIELD name="skytile" datatype="char" arraysize="*"><DESCRIPTION>Sky tile ID</DESCRIPTION></FIELD>
<FIELD name="id_src" datatype="short"><DESCRIPTION>Source ID in each sky tile</DESCRIPTION></FIELD>
<FIELD name="id_cluster" datatype="short"><DESCRIPTION>Group ID of simultaneously fitted sources</DESCRIPTION></FIELD>
<FIELD name="detuid" datatype="char" arraysize="*"><DESCRIPTION>Unique detection ID</DESCRIPTION></FIELD>
<FIELD name="uid" datatype="long"><DESCRIPTION>Integer unique detection ID</DESCRIPTION></FIELD>
<FIELD name="uid_5xmm" datatype="long"><DESCRIPTION>Unknown</DESCRIPTION></FIELD>
<FIELD name="uid_csc" datatype="char" arraysize="*"><DESCRIPTION>Unknown</DESCRIPTION></FIELD>
<FIELD name="flag_csc" datatype="long"><DESCRIPTION>Unknown</DESCRIPTION></FIELD>
<FIELD name="uid_2rxs" datatype="long"><DESCRIPTION>Unknown</DESCRIPTION></FIELD>
<FIELD name="uid_dr1" datatype="long"><DESCRIPTION>Unknown</DESCRIPTION></FIELD>
<FIELD name="uid_hard" datatype="long"><DESCRIPTION>Hard catalog UID</DESCRIPTION></FIELD>
<FIELD name="ra" datatype="double" unit="deg" ucd="POS_EQ_RA_MAIN"><DESCRIPTION>Right ascension (ICRS), corrected</DESCRIPTION></FIELD>
<FIELD name="dec" datatype="double" unit="deg" ucd="POS_EQ_DEC_MAIN"><DESCRIPTION>Declination (ICRS), corrected</DESCRIPTION></FIELD>
<FIELD name="pos_err" datatype="double" unit="arcsec"><DESCRIPTION>Combined position error, from PSF fitting</DESCRIPTION></FIELD>
<FIELD name="ra_lowerr" datatype="float" unit="arcsec"><DESCRIPTION>1-sigma RA lower bound</DESCRIPTION></FIELD>
<FIELD name="ra_uperr" datatype="float" unit="arcsec"><DESCRIPTION>1-sigma RA upper bound</DESCRIPTION></FIELD>
<FIELD name="dec_lowerr" datatype="float" unit="arcsec"><DESCRIPTION>1-sigma DEC lower bound</DESCRIPTION></FIELD>
<FIELD name="dec_uperr" datatype="float" unit="arcsec"><DESCRIPTION>1-sigma DEC upper bound</DESCRIPTION></FIELD>
<FIELD name="radec_err" datatype="float" unit="arcsec"><DESCRIPTION>1-sigma position uncertainty</DESCRIPTION></FIELD>
<FIELD name="ra_raw" datatype="double" unit="deg"><DESCRIPTION>Right ascension (ICRS), uncorrected</DESCRIPTION></FIELD>
<FIELD name="dec_raw" datatype="double" unit="deg"><DESCRIPTION>Declination (ICRS), uncorrected</DESCRIPTION></FIELD>
<FIELD name="lii" datatype="double" unit="deg"><DESCRIPTION>Galactic longitude</DESCRIPTION></FIELD>
<FIELD name="bii" datatype="double" unit="deg"><DESCRIPTION>Galactic latitude</DESCRIPTION></FIELD>
<FIELD name="elon" datatype="double" unit="deg"><DESCRIPTION>Ecliptic longitude</DESCRIPTION></FIELD>
<FIELD name="elat" datatype="double" unit="deg"><DESCRIPTION>Ecliptic latitude</DESCRIPTION></FIELD>
<FIELD name="ext" datatype="float" unit="arcsec"><DESCRIPTION>Source extent parameter</DESCRIPTION></FIELD>
<FIELD name="ext_err" datatype="float" unit="arcsec"><DESCRIPTION>1-sigma error on EXT</DESCRIPTION></FIELD>
<FIELD name="ext_lowerr" datatype="float" unit="arcsec"><DESCRIPTION>1-sigma EXT lower bound</DESCRIPTION></FIELD>
<FIELD name="ext_uperr" datatype="float" unit="arcsec"><DESCRIPTION>1-sigma EXT upper bound</DESCRIPTION></FIELD>
<FIELD name="ext_like" datatype="float"><DESCRIPTION>Extent likelihood</DESCRIPTION></FIELD>
<FIELD name="det_like_0" datatype="float"><DESCRIPTION>Detection likelihood (band 0)</DESCRIPTION></FIELD>
<FIELD name="ml_cts_1" datatype="float" unit="count"><DESCRIPTION>Source net counts (band 1)</DESCRIPTION></FIELD>
<FIELD name="ml_cts_err_1" datatype="float" unit="count"><DESCRIPTION>1-sigma error on ML_CTS_1</DESCRIPTION></FIELD>
<FIELD name="ml_cts_lowerr_1" datatype="float" unit="count"><DESCRIPTION>1-sigma ML_CTS_1 lower bound</DESCRIPTION></FIELD>
<FIELD name="ml_cts_uperr_1" datatype="float" unit="count"><DESCRIPTION>1-sigma ML_CTS_1 upper bound</DESCRIPTION></FIELD>
<FIELD name="ml_rate_1" datatype="float" unit="count.s**-1"><DESCRIPTION>Source count rate (band 1)</DESCRIPTION></FIELD>
<FIELD name="ml_rate_err_1" datatype="float" unit="count.s**-1"><DESCRIPTION>1-sigma error on ML_RATE_1</DESCRIPTION></FIELD>
<FIELD name="ml_rate_lowerr_1" datatype="float" unit="count.s**-1"><DESCRIPTION>1-sigma ML_RATE_1 lower bound</DESCRIPTION></FIELD>
<FIELD name="ml_rate_uperr_1" datatype="float" unit="count.s**-1"><DESCRIPTION>1-sigma ML_RATE_1 upper bound</DESCRIPTION></FIELD>
