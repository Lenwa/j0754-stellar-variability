<FIELD name="ape_cts_1" datatype="short" unit="count"><DESCRIPTION>Total counts extracted within the aperture (band 1)</DESCRIPTION></FIELD>
<FIELD name="ape_bkg_1" datatype="float" unit="count"><DESCRIPTION>Background counts extracted within the aperture, excluding nearby sources using the source map (band 1)</DESCRIPTION></FIELD>
