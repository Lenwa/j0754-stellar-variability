# %ECSV 1.0
# ---
# datatype:
# - name: iauname
#   datatype: string
#   description: Official IAU name of source
#   meta: !!omap
#   - {ucd: ID_MAIN}
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - name: detuid
#   datatype: string
#   description: Unique detection ID
#   meta: !!omap
#   - {_votable_string_dtype: char}
#   - {_votable_arraysize: '*'}
#   subtype: json
# - {name: skytile, datatype: int32, description: Sky tile ID}
# - {name: id_src, datatype: int32, description: Source ID in each sky tile}
# - {name: uid, datatype: int64, description: Integer unique detection ID}
# - {name: uid_hard, datatype: int64, description: Hard catalog UID}
# - {name: id_cluster, datatype: int32, description: Group ID of simultaneously fitted sources}
# - name: ra
#   unit: deg
#   datatype: float64
#   description: Right ascension (ICRS), corrected
#   meta: !!omap
#   - {ucd: POS_EQ_RA_MAIN}
# - name: dec
#   unit: deg
#   datatype: float64
#   description: Declination (ICRS), corrected
#   meta: !!omap
#   - {ucd: POS_EQ_DEC_MAIN}
# - {name: ra_raw, unit: deg, datatype: float64, description: 'Right ascension (ICRS), uncorrected'}
# - {name: dec_raw, unit: deg, datatype: float64, description: 'Declination (ICRS), uncorrected'}
# - {name: ra_lowerr, unit: arcsec, datatype: float32, description: 1-sigma RA lower bound}
# - {name: ra_uperr, unit: arcsec, datatype: float32, description: 1-sigma RA upper bound}
# - {name: dec_lowerr, unit: arcsec, datatype: float32, description: 1-sigma DEC lower bound}
# - {name: dec_uperr, unit: arcsec, datatype: float32, description: 1-sigma DEC upper bound}
# - {name: pos_err, datatype: float32, description: 'Combined position error, from PSF fitting'}
# - {name: radec_err, datatype: float32, description: 1-sigma position uncertainty}
# - {name: lii, unit: deg, datatype: float64, description: Galactic longitude}
# - {name: bii, unit: deg, datatype: float64, description: Galactic latitude}
# - {name: elon, unit: deg, datatype: float64, description: Ecliptic longitude}
# - {name: elat, unit: deg, datatype: float64, description: Ecliptic latitude}
# - {name: mjd, unit: d, datatype: float32, description: Epoch of the observation of the source nearest to the optical axis of the telescope}
# - {name: mjd_min, unit: d, datatype: float32, description: Epoch of the first observation of a source}
# - {name: mjd_max, unit: d, datatype: float32, description: Epoch of the last observation of a source}
# - {name: ext, unit: arcsec, datatype: float32, description: Source extent parameter}
# - {name: ext_err, unit: arcsec, datatype: float32, description: 1-sigma error on EXT}
# - {name: ext_lowerr, unit: arcsec, datatype: float32, description: 1-sigma EXT lower bound}
# - {name: ext_uperr, unit: arcsec, datatype: float32, description: 1-sigma EXT upper bound}
# - {name: ext_like, datatype: float32, description: Extent likelihood}
# - {name: det_like_0, datatype: float32, description: Detection likelihood (band 0)}
# - {name: ml_cts_1, unit: count, datatype: float32, description: Source net counts (band 1)}
# - {name: ml_cts_err_1, unit: count, datatype: float32, description: 1-sigma error on ML_CTS_1}
# - {name: ml_cts_lowerr_1, unit: count, datatype: float32, description: 1-sigma ML_CTS_1 lower bound}
# - {name: ml_cts_uperr_1, unit: count, datatype: float32, description: 1-sigma ML_CTS_1 upper bound}
# - {name: ml_rate_1, unit: count.s**-1, datatype: float32, description: Source count rate (band 1)}
# - {name: ml_rate_err_1, unit: count.s**-1, datatype: float32, description: 1-sigma error on ML_RATE_1}
# - {name: ml_rate_lowerr_1, unit: count.s**-1, datatype: float32, description: 1-sigma ML_RATE_1 lower bound}
# - {name: ml_rate_uperr_1, unit: count.s**-1, datatype: float32, description: 1-sigma ML_RATE_1 upper bound}
# - {name: ml_flux_1, unit: cm**-2.erg.s**-1, datatype: float32, description: Source flux (band 1)}
# - {name: ml_flux_err_1, unit: cm**-2.erg.s**-1, datatype: float32, description: 1-sigma error on ML_FLUX_1}
# - {name: ml_flux_lowerr_1, unit: cm**-2.erg.s**-1, datatype: float32, description: 1-sigma ML_FLUX_1 lower bound}
# - {name: ml_flux_uperr_1, unit: cm**-2.erg.s**-1, datatype: float32, description: 1-sigma ML_FLUX_1 upper bound}
# - {name: ml_bkg_1, unit: arcmin**-2, datatype: float32, description: Background at source position (band 1)}
# - {name: ml_exp_1, unit: s, datatype: float32, description: Vignetted exposure at source position (band 1)}
# - {name: ml_eef_1, datatype: float32, description: Encircled energy fraction (band 1)}
# - {name: ape_cts_1, unit: count, datatype: int32, description: Total counts extracted within the aperture (band 1)}
# - {name: ape_bkg_1, unit: count, datatype: float32, description: 'Background counts extracted within the aperture, excluding nearby
#     sources using the source map (band 1)'}
# - {name: ape_exp_1, unit: s, datatype: float32, description: Exposure map value at the given position (band 1)}
# - {name: ape_radius_1, unit: pixel, datatype: float32, description: Extraction radius in pixels (4 arcsec; band 1)}
# - {name: ape_pois_1, datatype: float32, description: Poisson probability that the extracted counts (APE_CTS_1) are a background fluctuation}
